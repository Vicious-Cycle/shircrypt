from typing import Literal

Buffer = bytes | bytearray | memoryview

__version__: str
BACKEND: Literal["rust", "cryptography", "pure-python"]

class NativeAuthKey:
    def __init__(self, key: Buffer) -> None: ...
    @property
    def key(self) -> bytes: ...
    @property
    def key_id_bytes(self) -> bytes: ...
    @property
    def aux_hash(self) -> bytes: ...
    @property
    def key_id(self) -> int: ...
    def seal_packet(self, inner_payload: Buffer, from_client: bool = True) -> bytes: ...
    def open_packet(self, packet: Buffer, from_client: bool = False) -> bytes: ...

def factorize_pq(pq: int) -> tuple[int, int]: ...
def ige256_encrypt(data: Buffer, key: Buffer, iv: Buffer) -> bytes: ...
def ige256_decrypt(data: Buffer, key: Buffer, iv: Buffer) -> bytes: ...
def ctr256_crypt(data: Buffer, key: Buffer, iv: Buffer, offset: int = 0) -> bytes: ...
def cbc256_encrypt(data: Buffer, key: Buffer, iv: Buffer) -> bytes: ...
def cbc256_decrypt(data: Buffer, key: Buffer, iv: Buffer) -> bytes: ...
def compute_msg_key(auth_key: Buffer, padded_plaintext: Buffer, from_client: bool = True) -> bytes: ...
def mtproto2_kdf(auth_key: Buffer, msg_key: Buffer, from_client: bool = True) -> tuple[bytes, bytes]: ...
def mtproto2_encrypt_packet(auth_key: Buffer, padded_plaintext: Buffer, from_client: bool = True) -> tuple[bytes, bytes]: ...
def mtproto2_decrypt_packet(auth_key: Buffer, msg_key: Buffer, ciphertext: Buffer, from_client: bool = False) -> bytes: ...
